{
  "services": {
    "web": {
      "root": ".",
      "framework": "nextjs",
      "buildCommand": "npm install && npx prisma generate && npm run build"
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": {
        "type": "service",
        "service": "web"
      }
    }
  ]
}
